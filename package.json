{
  "name": "community-board",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint app client components lib mcp tests worker --max-warnings=0",
    "mcp": "node mcp/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm test && npm run typecheck && npm run build && npm run audit:dependencies",
    "audit:dependencies": "npm audit --audit-level=low"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@radix-ui/react-dialog": "1.1.23",
    "clsx": "2.1.1",
    "lucide-react": "^1.31.0",
    "nostr-tools": "2.25.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.5",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "prettier": "3.6.2",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "wrangler": "4.146.0",
    "ws": "8.22.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "globals": "16.4.0",
    "typescript-eslint": "8.59.3"
  },
  "type": "module"
}
